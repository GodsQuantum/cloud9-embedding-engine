[Unit]
Description=Cloud9 Embedding Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/cloud9-embedding-engine/engine.env
ExecStart=/usr/local/bin/cloud9-embedding-server
Restart=on-failure
RestartSec=3
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
