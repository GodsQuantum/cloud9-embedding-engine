# Model
C9EE_MODEL_ID=qwen3-0.6b-q8
# Optional local model path. When set, it takes precedence over Hugging Face.
# C9EE_MODEL_PATH=/srv/models/embeddings/Qwen3-Embedding-0.6B-Q8_0.gguf

# Runtime
C9EE_PROFILE=production
C9EE_HOST=127.0.0.1
C9EE_PORT=8091
C9EE_GPU_LAYERS=999
C9EE_BATCH=2048
# Optional per-profile override; defaults: production=512, balanced=1024, bulk=2048
# C9EE_UBATCH=512
# Embedding prompts are normally unique; disable llama.cpp host prompt cache by default.
# Set a positive MiB value only after measuring a repeated-prompt workload.
C9EE_CACHE_RAM=0

# Optional binary override
# C9EE_LLAMA_SERVER=/opt/llama.cpp/bin/llama-server
